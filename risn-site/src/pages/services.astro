---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Services — Risn" description="Web design & development, SEO, and PPC for local trade and service businesses. Fast delivery, no hidden fees.">
  <Nav currentPage="/services" />

  <main>
    <!-- Page hero -->
    <section class="page-hero section">
      <div class="section-inner">
        <div class="reveal">
          <span class="eyebrow">What we do</span>
          <h1>Everything you need.<br>Nothing you don't.</h1>
          <p class="page-hero-sub">Three focused services, each designed to make local businesses more visible, more trusted, and more busy.</p>
        </div>
      </div>
    </section>

    <!-- Web Design -->
    <section class="service-section section" id="web">
      <div class="section-inner service-inner">
        <div class="service-text reveal">
          <div class="service-tag">01 / Web Design & Development</div>
          <h2>Sites that convert,<br>not just impress</h2>
          <p class="service-body">Your website is your hardest-working salesperson. We design and build bespoke sites that load fast, look great on any device, and are built from the ground up to turn visitors into enquiries.</p>
          <p class="service-body">No page builders, no bloated themes — clean code, lightning PageSpeed scores, and a site that actually represents your business.</p>
          <ul class="feature-list">
            <li>Bespoke design — no templates</li>
            <li>90+ PageSpeed score, guaranteed</li>
            <li>Mobile-first, fully responsive</li>
            <li>14-day average delivery</li>
            <li>CMS so you can update content yourself</li>
            <li>Ongoing hosting & maintenance available</li>
          </ul>
          <a href="/contact?service=Web+Design+%26+Development" class="btn-primary">Enquire about web design →</a>
        </div>
        <div class="service-visual reveal">
          <!-- TODO: Replace with a real screenshot / mockup of a client site -->
          <div class="visual-placeholder">
            <div class="visual-bar"></div>
            <div class="visual-label">Client site preview</div>
            <div class="visual-grid">
              <div class="vg-block wide"></div>
              <div class="vg-block"></div>
              <div class="vg-block"></div>
              <div class="vg-block wide"></div>
              <div class="vg-block"></div>
              <div class="vg-block"></div>
            </div>
            <p class="visual-note">[ Screenshot placeholder — add real client work here ]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO -->
    <section class="service-section section alt-section" id="seo">
      <div class="section-inner service-inner reverse">
        <div class="service-visual reveal">
          <div class="visual-placeholder">
            <div class="visual-bar"></div>
            <div class="visual-label">Local rankings</div>
            <div class="rank-list">
              <div class="rank-item"><span class="rank-pos orange">#1</span><span class="rank-query">roofer in [your town]</span></div>
              <div class="rank-item"><span class="rank-pos orange">#1</span><span class="rank-query">local builder [your area]</span></div>
              <div class="rank-item"><span class="rank-pos">#2</span><span class="rank-query">landscaping company near me</span></div>
              <div class="rank-item"><span class="rank-pos">#3</span><span class="rank-query">emergency plumber [city]</span></div>
            </div>
            <p class="visual-note">[ Replace with real ranking data ]</p>
          </div>
        </div>
        <div class="service-text reveal">
          <div class="service-tag">02 / Search Engine Optimisation</div>
          <h2>Be found when<br>it matters most</h2>
          <p class="service-body">When someone searches "plumber near me" or "best roofer in [your town]", you want to be at the top. Local SEO puts you there — and keeps you there.</p>
          <p class="service-body">We handle everything from Google Business Profile optimisation to on-page content, citations, and link building. Transparent reporting every month, no jargon.</p>
          <ul class="feature-list">
            <li>Google Business Profile setup & optimisation</li>
            <li>Local keyword research & targeting</li>
            <li>On-page SEO for every page</li>
            <li>Citation building & NAP consistency</li>
            <li>Monthly reporting in plain English</li>
            <li>No long-term contract required</li>
          </ul>
          <a href="/contact?service=SEO" class="btn-primary">Enquire about SEO →</a>
        </div>
      </div>
    </section>

    <!-- PPC -->
    <section class="service-section section" id="ppc">
      <div class="section-inner service-inner">
        <div class="service-text reveal">
          <div class="service-tag">03 / Pay Per Click</div>
          <h2>Ads that pay for<br>themselves</h2>
          <p class="service-body">Google Ads can be a money pit — or a growth engine. The difference is in the setup. We build tightly-targeted campaigns that reach the right people, with copy that converts and bids that don't bleed budget.</p>
          <p class="service-body">Full transparency on spend, clicks, and leads. You'll know exactly where every pound goes.</p>
          <ul class="feature-list">
            <li>Google Search & Local Services Ads</li>
            <li>Keyword research & negative keyword management</li>
            <li>Ad copy written and tested for your market</li>
            <li>Landing page optimisation</li>
            <li>Conversion tracking setup</li>
            <li>Monthly performance reports</li>
          </ul>
          <a href="/contact?service=PPC" class="btn-primary">Enquire about PPC →</a>
        </div>
        <div class="service-visual reveal">
          <div class="visual-placeholder">
            <div class="visual-bar"></div>
            <div class="visual-label">Campaign performance</div>
            <div class="perf-stats">
              <div class="perf-item"><div class="perf-num">4.2<span>×</span></div><div class="perf-lbl">ROAS average</div></div>
              <div class="perf-item"><div class="perf-num">£12<span></span></div><div class="perf-lbl">Avg. cost per lead</div></div>
              <div class="perf-item"><div class="perf-num">38<span>%</span></div><div class="perf-lbl">Lower CPC vs. unmanaged</div></div>
            </div>
            <p class="visual-note">[ Replace with real campaign data ]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-band">
      <div class="section-inner cta-inner reveal">
        <div>
          <h2>Not sure where to start?</h2>
          <p class="cta-sub">We'll help you figure out the best combination for your business — no sales pitch, just honest advice.</p>
        </div>
        <a href="/contact" class="btn-primary">Book a free call →</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main { padding-top: 80px; }

  .page-hero-sub {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.8;
    font-weight: 300;
    max-width: 520px;
    margin-top: 18px;
  }

  h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    letter-spacing: -1.5px;
    line-height: 1.05;
    margin-top: 10px;
  }

  /* Service sections */
  .alt-section { background: var(--charcoal-mid); }

  .service-inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .service-tag {
    font-size: 0.68rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--orange);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .service-body {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.85;
    font-weight: 300;
    margin-bottom: 14px;
    max-width: 520px;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.75);
  }

  .feature-list li::before {
    content: '';
    width: 5px; height: 5px;
    background: var(--orange);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Visuals / placeholders */
  .service-visual { flex: 0 0 auto; }

  .visual-placeholder {
    background: var(--charcoal-mid);
    border: 1px solid var(--subtle);
    border-radius: 12px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    min-height: 260px;
  }

  .alt-section .visual-placeholder { background: var(--charcoal); }

  .visual-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--orange), transparent);
  }

  .visual-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--orange);
    font-weight: 500;
    margin-bottom: 20px;
  }

  .visual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }

  .vg-block {
    height: 32px;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
  }

  .vg-block.wide { grid-column: span 2; height: 48px; }

  .visual-note {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.2);
    font-style: italic;
    margin-top: 12px;
  }

  /* Rank list */
  .rank-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }

  .rank-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgba(255,255,255,0.03);
    border-radius: 6px;
    border: 1px solid var(--subtle);
  }

  .rank-pos {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    min-width: 28px;
    color: rgba(255,255,255,0.3);
  }

  .rank-pos.orange { color: var(--orange); }
  .rank-query { font-size: 0.82rem; color: rgba(255,255,255,0.55); }

  /* Perf stats */
  .perf-stats { display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; }

  .perf-item { padding: 14px; background: rgba(255,255,255,0.03); border-radius: 8px; border: 1px solid var(--subtle); }

  .perf-num {
    font-family: 'Syne', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 4px;
  }

  .perf-num span { color: var(--orange); }
  .perf-lbl { font-size: 0.76rem; color: var(--muted); }

  /* CTA band */
  .cta-band { border-top: 1px solid var(--subtle); }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .cta-sub {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.8;
    font-weight: 300;
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .service-inner {
      flex-direction: row;
      align-items: center;
      gap: 72px;
    }

    .service-inner.reverse { flex-direction: row-reverse; }

    .service-text { flex: 1; }
    .service-visual { flex: 0 0 380px; }

    .perf-stats { flex-direction: row; }

    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .cta-inner .btn-primary { flex-shrink: 0; }
  }
</style>

<script>
  const ro = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.07 }
  );
  document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
</script>
